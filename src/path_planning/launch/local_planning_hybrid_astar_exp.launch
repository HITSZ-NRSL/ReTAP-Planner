<launch>
	<node name="local_planning_node" pkg="path_planning" type="hybrid_astar" output="screen">
		<param name="map_frame" value="map" />
		<param name="lookahead_distance" value="100" />
		<param name="debug" value="false" />
		<param name="global_mode" value="false" />

		<param name="base_footprint_frame" value="base" />
		<param name="track_width" value="0.075" />
		<param name="track_length" value="0.672" />
		<param name="track_separation" value="0.329" />
		<param name="flipper_width" value="0.040" />
		<param name="flipper_length" value="0.192" />
		<param name="flipper_separation" value="0.45" />
		<param name="costmap" value="true" />
		<remap from="local_planning/path_configs" to="next_base_path/config" />
		<!-- <remap from="local_planning/pose_array_input" to="/next_base_path"/> -->
		<!-- <remap from="local_planning/pose_array_output" to="/next_base_path/config"/> -->
	</node>
</launch>