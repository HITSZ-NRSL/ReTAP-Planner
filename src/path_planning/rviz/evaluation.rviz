    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Path1/Offset1
        - /PathPCD1
      Splitter Ratio: 0.6948717832565308
    Tree Height: 667
  - Class: rviz/Selection
