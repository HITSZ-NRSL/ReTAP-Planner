  vPoint getConvexHull_Qhull() {
    hull_quick.clear();
    std::vector<double> allCoords;
    for (int i = 0; i < input.size(); i++) {
      allCoords.push_back(input[i].x());
      allCoords.push_back(input[i].y());
    }
    double *buffer = new double[allCoords.size()];
    memcpy(buffer, &allCoords[0], allCoords.size() * sizeof(double));

    char inputComment2[] = "";
    char qhullCommand2[] = "";

    try {
      orgQhull::Qhull qhull;
      qhull.runQhull(inputComment2, 2, input.size(), buffer, qhullCommand2);
      auto vertices = qhull.vertexList();
      ROS_INFO("<getConvexHull_Qhull>: vertices = %d", (int)vertices.size());
      for (auto p : vertices) {
        double *coord = p.point().coordinates();
        ROS_INFO("<getConvexHull_Qhull>: coord[%.3f, %.3f]", coord[0],
                 coord[1]);
        hull_quick.push_back(Point(coord[0], coord[1], 0));
      }
    } catch (...) {
      ROS_ERROR("runQhull execption.");
    }
    ROS_INFO("<getConvexHull_Qhull>: fill hull_quick ok");
    delete[] buffer;
    ROS_INFO("<getConvexHull_Qhull>: delete buffer ok");
    std::sort(hull_quick.begin(), hull_quick.end(), azimuthCmp);
    return hull_quick;
  }

